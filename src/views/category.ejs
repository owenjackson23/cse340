<%- include('partials/header') %>
    <main>

        <h1>
            <%= categoryDetails.category_name %>
        </h1>

        <h2>Service Projects</h2>
        <ul class="main-list">
            <% projects.forEach(project=> { %>
                <li><a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a></li>
                <% }) %>
        </ul>
    </main>
    <%- include('partials/footer') %>