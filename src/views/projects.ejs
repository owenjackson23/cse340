<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul class="main-list">
            <% projects.forEach(project=> { %>
                <li>
                    <p>
                        Date: <%= project.date %>
                    </p>
                    <strong>
                        <%= project.title %>
                    </strong> (<%= project.organization_name %>)
                        <p>
                            <%= project.description %>
                        </p>
                        <p>
                            Location: <%= project.location %>
                        </p>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>