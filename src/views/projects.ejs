<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <ul class="main-list">
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <p>
                            Date: <%= project.date %>
                        </p>
                        <strong>
                            <%= project.title %>
                        </strong> (<a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>)
                        <p>
                            <%= project.description %>
                        </p>
                        <p>
                            Location: <%= project.location %>
                        </p>
                    </a>
                </li>
                <% }); %>
        </ul>

        <p><a href="/new-project">Add a New Service Project</a></p>
    </main>

    <%- include('partials/footer') %>