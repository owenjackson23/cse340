<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul class="main-list">
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= project.title %>
                    </strong>
                    <p>
                        <%= project.organization_name %>
                    </p>
                    <p>
                        <%= project.description %>
                    </p>
                    <p>Location: <%= project.location %>
                    </p>
                    <p>Date: <%= project.date %>
                    </p>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>