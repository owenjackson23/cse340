<%- include('partials/header') %>
    <main>

        <h1>
            <%= projectDetails.title %>
        </h1>

        <p><strong>Description:</strong>
            <%= projectDetails.description %>
        </p>

        <p><strong>Date:</strong>
            <%= projectDate %>
        </p>

        <p><strong>Location:</strong>
            <%= projectDetails.location %>
        </p>

        <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a></p>

        <h3>Categories:</h3>
        <ul class="main-list">
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
                <% }) %>
        </ul>
        <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>

        <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    </main>
    <%- include('partials/footer') %>